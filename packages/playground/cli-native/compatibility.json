{
	"schemaVersion": 1,
	"scope": "Native v1 Node CLI compatibility contract",
	"commands": [
		{
			"name": "start",
			"status": "supported",
			"notes": "Normalizes into the native server runtime with managed persistent storage, auto-mounting, login, reset, and browser-opening defaults."
		},
		{
			"name": "server",
			"status": "supported",
			"notes": "Runs the native HTTP server, WordPress bootstrap, worker pool, mounts, Blueprint-on-start, and PHP SAPI routing."
		},
		{
			"name": "run-blueprint",
			"status": "supported",
			"notes": "Runs the native one-shot WordPress bootstrap and Blueprint v1 startup-step interpreter without opening a server listener. Unsupported Blueprint steps fail explicitly."
		},
		{
			"name": "build-snapshot",
			"status": "supported",
			"notes": "Boots the native WordPress runtime, applies startup Blueprint steps, and writes a ZIP snapshot of the visible /wordpress tree."
		}
	],
	"options": [
