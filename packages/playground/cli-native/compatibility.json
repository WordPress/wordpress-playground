{
	"schemaVersion": 1,
	"scope": "Native v1 Node CLI compatibility contract",
	"commands": [
		{
			"name": "start",
			"status": "supported",
			"notes": "Normalizes into the native server runtime with managed persistent storage, auto-mounting, login, reset, and browser-opening defaults."
		},
		{
			"name": "server",
			"status": "supported",
			"notes": "Runs the native HTTP server, WordPress bootstrap, worker pool, mounts, Blueprint-on-start, and PHP SAPI routing."
		},
		{
			"name": "php",
			"status": "supported",
			"notes": "Runs PHP CLI mode through the native Wasmtime host. Unknown PHP long options pass through after native option parsing."
		},
		{
			"name": "run-blueprint",
			"status": "supported",
			"notes": "Runs the native one-shot WordPress bootstrap and Blueprint v1 startup-step interpreter without opening a server listener. Unsupported Blueprint steps fail explicitly."
		},
		{
			"name": "build-snapshot",
			"status": "supported",
			"notes": "Boots the native WordPress runtime, applies startup Blueprint steps, and writes a ZIP snapshot of the visible /wordpress tree."
		}
	],
	"options": [
		{ "name": "--path", "commands": ["start"], "status": "supported" },
		{ "name": "--wp", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--php", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--port", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--site-url", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--mount", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--mount-before-install", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--mount-dir", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--mount-dir-before-install", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--auto-mount", "commands": ["start", "server", "run-blueprint", "build-snapshot"], "status": "supported" },
		{ "name": "--no-auto-mount", "commands": ["start", "server", "run-blueprint", "build-snapshot"], "status": "supported" },
		{ "name": "--reset", "commands": ["start"], "status": "supported" },
		{ "name": "--login", "commands": ["start", "server"], "status": "supported" },
		{ "name": "--no-login", "commands": ["start", "server"], "status": "supported" },
		{ "name": "--skip-browser", "commands": ["start"], "status": "supported" },
		{ "name": "--blueprint", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{
			"name": "--blueprint-may-read-adjacent-files",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "supported"
		},
		{ "name": "--wordpress-install-mode", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--skip-wordpress-install", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--skip-sqlite-setup", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--workers", "commands": ["server", "start"], "status": "supported" },
		{ "name": "--verbosity", "commands": ["start", "server", "run-blueprint", "build-snapshot"], "status": "supported" },
		{ "name": "--quiet", "commands": ["start", "server", "run-blueprint", "build-snapshot"], "status": "supported" },
		{ "name": "--debug", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--follow-symlinks", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{
			"name": "--intl",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "supported",
			"notes": "Accepted as a compatibility no-op because Intl is built into the packaged PHP wasm assets."
		},
		{
			"name": "--opcache",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "supported",
				"notes": "Native-only OPcache policy: validate preserves live edits; revalidate and immutable trade fresher PHP files for warm-request speed; low-memory and off are benchmark/diagnostic modes."
		},
		{ "name": "--define", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--define-bool", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{ "name": "--define-number", "commands": ["start", "server", "run-blueprint", "build-snapshot", "php"], "status": "supported" },
		{
			"name": "--phpmyadmin",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "unsupported",
			"errorContains": "phpMyAdmin installation"
		},
		{
			"name": "--xdebug",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "unsupported",
			"errorContains": "Xdebug bridge"
		},
		{
			"name": "--experimental-unsafe-ide-integration",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "unsupported",
			"errorContains": "unsafe IDE integration"
		},
		{
			"name": "--experimental-devtools",
			"commands": ["start", "server"],
			"status": "unsupported",
			"errorContains": "browser devtools bridge"
		},
		{
			"name": "--experimental-blueprints-v2-runner",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "unsupported",
			"errorContains": "Blueprints v2 runner"
		},
		{
			"name": "--experimental-multi-worker",
			"commands": ["server"],
			"status": "unsupported",
			"errorContains": "deprecated Node worker option"
		},
		{
			"name": "--experimental-trace",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "unsupported",
			"errorContains": "Node CLI trace output"
		},
		{
			"name": "--internal-cookie-store",
			"commands": ["server"],
			"status": "unsupported",
			"errorContains": "Node cookie-store mediation"
		},
		{
			"name": "--php-extension",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "unsupported",
			"errorContains": "custom PHP extension loading"
		},
		{
			"name": "--no-intl",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "unsupported",
			"errorContains": "disabling bundled Intl"
		},
		{
			"name": "--mode",
			"commands": ["start", "server", "run-blueprint", "build-snapshot", "php"],
			"status": "unsupported",
			"errorContains": "Blueprints v2 mode selection"
		},
		{
			"name": "--outfile",
			"commands": ["build-snapshot"],
			"status": "supported"
		},
		{
			"name": "--redis",
			"commands": ["server"],
			"status": "unsupported",
			"errorContains": "Redis integration"
		},
		{
			"name": "--memcached",
			"commands": ["server"],
			"status": "unsupported",
			"errorContains": "Memcached integration"
		}
	]
}
