{
	"compilerOptions": {
		"jsx": "react-jsx",
		"allowJs": false,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"target": "ES2021",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "dom"],
		"types": ["chrome", "@nx/react/typings/cssmodule.d.ts"]
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules"],
	"extends": "../../../tsconfig.base.json"
}
