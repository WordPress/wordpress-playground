+case $host_alias in
+  wasm32*-wasi*)
+    dnl WASI components are statically linked and cannot load native DSOs.
+    ac_cv_func_dlopen=no
+    ac_cv_func_dlsym=no
+    ;;
+  *)
+    PHP_CHECK_FUNC(dlopen, dl)
+    PHP_CHECK_FUNC(dlsym, dl)
+    ;;
+esac
 if test "$ac_cv_func_dlopen" = "yes"; then
   AC_DEFINE(HAVE_LIBDL, 1, [ ])
 fi
