From 30313127a01f7e4507414657210c57edbfeb11d8 Mon Sep 17 00:00:00 2001
From: WordPress Playground contributors <playground@wordpress.org>
Date: Sat, 18 Jul 2026 06:35:00 +0200
Subject: [PATCH 13/13] Transfer zlib stream descriptors on WASI

WASI does not expose dup(), so transfer ownership of a cast PHP stream
descriptor to zlib instead. Freeing the PHP stream with
PHP_STREAM_FREE_CLOSE_CASTED releases its wrapper while preserving the
underlying descriptor; gzclose() then remains the sole descriptor owner.
---
 ext/zlib/zlib_fopen_wrapper.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/ext/zlib/zlib_fopen_wrapper.c b/ext/zlib/zlib_fopen_wrapper.c
--- a/ext/zlib/zlib_fopen_wrapper.c
+++ b/ext/zlib/zlib_fopen_wrapper.c
@@ -132,7 +132,16 @@ php_stream *php_stream_gzopen(php_stream_wrapper *wrapper, const char *path, con
 		if (SUCCESS == php_stream_cast(innerstream, PHP_STREAM_AS_FD, (void **) &fd, REPORT_ERRORS)) {
 			self = emalloc(sizeof(*self));
 			self->stream = innerstream;
+#ifdef PHP_WASI
+			self->gz_file = gzdopen(fd, mode);
+			if (self->gz_file) {
+				php_stream_free(innerstream, PHP_STREAM_FREE_CLOSE_CASTED);
+				innerstream = NULL;
+				self->stream = NULL;
+			}
+#else
 			self->gz_file = gzdopen(dup(fd), mode);
+#endif
 
 			if (self->gz_file) {
 				zval *zlevel = context ? php_stream_context_get_option(context, "zlib", "level") : NULL;
