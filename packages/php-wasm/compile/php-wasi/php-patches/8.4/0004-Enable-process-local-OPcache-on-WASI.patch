diff --git a/ext/opcache/ZendAccelerator.h b/ext/opcache/ZendAccelerator.h
index 486074ef..5d43291a 100644
--- a/ext/opcache/ZendAccelerator.h
+++ b/ext/opcache/ZendAccelerator.h
@@ -104,6 +104,55 @@ typedef unsigned __int64 accel_time_t;
 typedef time_t accel_time_t;
 #endif
 
+#ifdef PHP_WASI
+# define ZEND_ACCEL_NANOSECONDS_PER_SECOND 1000000000LL
+
+/* Reserve zero for OPcache's "timestamp unavailable" sentinel. */
+static inline accel_time_t zend_accel_timestamp_encode(accel_time_t timestamp)
+{
+	accel_time_t encoded;
+	if (timestamp >= 0) {
+		if (__builtin_add_overflow(timestamp, (accel_time_t) 1, &encoded)) {
+			return 0;
+		}
+		return encoded;
+	}
+	return timestamp;
+}
+
+static inline accel_time_t zend_accel_timestamp_decode(accel_time_t timestamp)
+{
+	return timestamp > 0 ? timestamp - 1 : timestamp;
+}
+#endif
+
+static inline accel_time_t zend_accel_timestamp_from_seconds(time_t timestamp)
+{
+#ifdef PHP_WASI
+	accel_time_t nanoseconds;
+	if (__builtin_mul_overflow(
+			(accel_time_t) timestamp,
+			(accel_time_t) ZEND_ACCEL_NANOSECONDS_PER_SECOND,
+			&nanoseconds)) {
+		return 0;
+	}
+	return zend_accel_timestamp_encode(nanoseconds);
+#else
+	return (accel_time_t) timestamp;
+#endif
+}
+
+static inline time_t zend_accel_timestamp_seconds(accel_time_t timestamp)
+{
+#ifdef PHP_WASI
+	return (time_t) (
+		zend_accel_timestamp_decode(timestamp) / ZEND_ACCEL_NANOSECONDS_PER_SECOND
+	);
+#else
+	return (time_t) timestamp;
+#endif
+}
+
 typedef enum _zend_accel_restart_reason {
 	ACCEL_RESTART_OOM,    /* restart because of out of memory */
 	ACCEL_RESTART_HASH,   /* restart because of hash overflow */
