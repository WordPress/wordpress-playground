From 6130d3bf3d5cff65f49c6e925c57c1e55f408a61 Mon Sep 17 00:00:00 2001
From: WordPress Playground contributors <playground@wordpress.org>
Date: Sat, 18 Jul 2026 04:40:31 +0200
Subject: [PATCH 09/12] Disable Unix domain sockets on WASI

---
 main/network.c           | 2 +-
 main/streams/streams.c   | 2 +-
 main/streams/xp_socket.c | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/main/network.c b/main/network.c
index 40a80a6f..b54f2c1d 100644
--- a/main/network.c
+++ b/main/network.c
@@ -61,7 +61,7 @@
 
 #include "php_network.h"
 
-#if defined(PHP_WIN32) || defined(__riscos__)
+#if defined(PHP_WIN32) || defined(__riscos__) || defined(PHP_WASI)
 #undef AF_UNIX
 #endif
 
diff --git a/main/streams/streams.c b/main/streams/streams.c
index 6feb8b7c..c5a0d4eb 100644
--- a/main/streams/streams.c
+++ b/main/streams/streams.c
@@ -1899,7 +1899,7 @@ int php_init_stream_wrappers(int module_number)
 	return (php_stream_xport_register("tcp", php_stream_generic_socket_factory) == SUCCESS
 			&&
 			php_stream_xport_register("udp", php_stream_generic_socket_factory) == SUCCESS
-#if defined(AF_UNIX) && !(defined(PHP_WIN32) || defined(__riscos__))
+#if defined(AF_UNIX) && !(defined(PHP_WIN32) || defined(__riscos__) || defined(PHP_WASI))
 			&&
 			php_stream_xport_register("unix", php_stream_generic_socket_factory) == SUCCESS
 			&&
diff --git a/main/streams/xp_socket.c b/main/streams/xp_socket.c
index 69eb0783..7174bd22 100644
--- a/main/streams/xp_socket.c
+++ b/main/streams/xp_socket.c
@@ -19,7 +19,7 @@
 #include "streams/php_streams_int.h"
 #include "php_network.h"
 
-#if defined(PHP_WIN32) || defined(__riscos__)
+#if defined(PHP_WIN32) || defined(__riscos__) || defined(PHP_WASI)
 # undef AF_UNIX
 #endif
 
-- 
2.50.1

