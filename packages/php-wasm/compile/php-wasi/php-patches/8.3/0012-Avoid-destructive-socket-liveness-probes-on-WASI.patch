From 5fe448c9297fca650e7ff51ffac0b73347efeec7 Mon Sep 17 00:00:00 2001
From: WordPress Playground contributors <playground@wordpress.org>
Date: Sat, 18 Jul 2026 04:28:41 +0200
Subject: [PATCH] Avoid destructive socket liveness probes on WASI

---
 main/streams/xp_socket.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/main/streams/xp_socket.c b/main/streams/xp_socket.c
index 511278fc..0768e013 100644
--- a/main/streams/xp_socket.c
+++ b/main/streams/xp_socket.c
@@ -342,7 +342,9 @@ static int php_sockop_set_option(php_stream *stream, int option, int value, void
 		case PHP_STREAM_OPTION_CHECK_LIVENESS:
 			{
 				struct timeval tv;
+#ifndef PHP_WASI
 				char buf;
+#endif
 				int alive = 1;
 
 				if (value == -1) {
@@ -357,6 +359,17 @@ static int php_sockop_set_option(php_stream *stream, int option, int value, void
 					tv.tv_usec = 0;
 				}
 
+#ifdef PHP_WASI
+				if (sock->socket == -1) {
+					alive = 0;
+				} else {
+					int events = php_pollfd_for(sock->socket, PHP_POLLREADABLE|POLLPRI, &tv);
+
+					if (events < 0 || (events & (POLLERR|POLLHUP|POLLNVAL))) {
+						alive = 0;
+					}
+				}
+#else
 				if (sock->socket == -1) {
 					alive = 0;
 				} else if (
@@ -382,6 +395,7 @@ static int php_sockop_set_option(php_stream *stream, int option, int value, void
 						alive = 0;
 					}
 				}
+#endif
 				return alive ? PHP_STREAM_OPTION_RETURN_OK : PHP_STREAM_OPTION_RETURN_ERR;
 			}
 
-- 
