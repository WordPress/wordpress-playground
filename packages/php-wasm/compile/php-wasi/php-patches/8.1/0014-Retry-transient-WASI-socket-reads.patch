From ddb64a0adf5e01fa7e20170f20e02d5fbba2dcf4 Mon Sep 17 00:00:00 2001
From: WordPress Playground contributors <playground@wordpress.org>
Date: Sat, 18 Jul 2026 14:12:00 +0200
Subject: [PATCH 14/14] Retry transient WASI socket reads

WASI readiness can race with recv(), leaving a blocking read with
EAGAIN or EWOULDBLOCK after poll reported readiness. Resume the normal
timeout-aware poll/read loop for blocking streams while preserving
zero-timeout and nonblocking behavior.
---
 main/streams/xp_socket.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/main/streams/xp_socket.c b/main/streams/xp_socket.c
--- a/main/streams/xp_socket.c
+++ b/main/streams/xp_socket.c
@@ -159,6 +159,9 @@ static ssize_t php_sockop_read(php_stream *stream, char *buf, size_t count)
		return -1;
	}
 
+#ifdef PHP_WASI
+retry:
+#endif
	if (sock->is_blocked) {
		php_sock_stream_wait_for_data(stream, sock);
		if (sock->timeout_event)
@@ -170,6 +173,14 @@ static ssize_t php_sockop_read(php_stream *stream, char *buf, size_t count)
 
	if (nr_bytes < 0) {
		if (PHP_IS_TRANSIENT_ERROR(err)) {
+#ifdef PHP_WASI
+			/* WASI readiness is advisory. Retry only reads that were intended
+			 * to block; nonblocking and zero-timeout reads must return promptly. */
+			if (sock->is_blocked &&
+					(sock->timeout.tv_sec != 0 || sock->timeout.tv_usec != 0)) {
+				goto retry;
+			}
+#endif
			nr_bytes = 0;
		} else {
			stream->eof = 1;
-- 
