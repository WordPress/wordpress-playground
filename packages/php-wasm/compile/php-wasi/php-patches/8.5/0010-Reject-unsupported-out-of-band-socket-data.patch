From bfe05eeab009f80b393f45ba010379de978fb932 Mon Sep 17 00:00:00 2001
From: WordPress Playground contributors <playground@wordpress.org>
Date: Sat, 18 Jul 2026 04:40:32 +0200
Subject: [PATCH 10/12] Reject unsupported out-of-band socket data

---
 main/streams/xp_socket.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/main/streams/xp_socket.c b/main/streams/xp_socket.c
index 56c5c306..49d673e8 100644
--- a/main/streams/xp_socket.c
+++ b/main/streams/xp_socket.c
@@ -435,7 +435,12 @@ static int php_sockop_set_option(php_stream *stream, int option, int value, void
 				case STREAM_XPORT_OP_SEND:
 					flags = 0;
 					if ((xparam->inputs.flags & STREAM_OOB) == STREAM_OOB) {
+#ifdef MSG_OOB
 						flags |= MSG_OOB;
+#else
+						xparam->outputs.returncode = -1;
+						return PHP_STREAM_OPTION_RETURN_OK;
+#endif
 					}
 					xparam->outputs.returncode = sock_sendto(sock,
 							xparam->inputs.buf, xparam->inputs.buflen,
@@ -453,7 +458,12 @@ static int php_sockop_set_option(php_stream *stream, int option, int value, void
 				case STREAM_XPORT_OP_RECV:
 					flags = 0;
 					if ((xparam->inputs.flags & STREAM_OOB) == STREAM_OOB) {
+#ifdef MSG_OOB
 						flags |= MSG_OOB;
+#else
+						xparam->outputs.returncode = -1;
+						return PHP_STREAM_OPTION_RETURN_OK;
+#endif
 					}
 					if ((xparam->inputs.flags & STREAM_PEEK) == STREAM_PEEK) {
 						flags |= MSG_PEEK;
-- 
