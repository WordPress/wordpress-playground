diff --git a/Zend/zend_wasi.c b/Zend/zend_wasi.c
index ec5c6f901b..ff8cfb6238 100644
--- a/Zend/zend_wasi.c
+++ b/Zend/zend_wasi.c
@@ -14,13 +14,8 @@
    +----------------------------------------------------------------------+
 */
 
-#include "zend.h"
-
-ZEND_API ZEND_COLD ZEND_NORETURN void _zend_bailout(const char *filename,
-                                                    uint32_t lineno) /* {{{ */
-{
-  // Not implemented yet, as WebAssembly has no stack switching
-  // feature implementation at this point.
-	zend_throw_exception(NULL, "Exception bailout is not supported yet on this platform (wasm32-wasi)", 0);
-}
-/* }}} */
+/*
+ * Zend bailout is implemented by the regular Zend/zend.c code. The build
+ * enables LLVM's WebAssembly SJLJ lowering, so this target preserves the same
+ * non-local control flow contract as native PHP.
+ */
