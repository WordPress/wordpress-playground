-	 PHP_ADD_SOURCES(main, fastcgi_wasi.c network_wasi.c php_open_temporary_file_wasi.c unistd_wasi.c,)
+	 PHP_ADD_SOURCES(main, network_wasi.c unistd_wasi.c,)
