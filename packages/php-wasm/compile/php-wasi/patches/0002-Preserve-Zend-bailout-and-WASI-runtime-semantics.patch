+  wasm32*-wasi*)
+    dnl WASI components are statically linked and cannot load native DSOs.
+    ac_cv_func_dlopen=no
+    ac_cv_func_dlsym=no
+    ;;
+  *)
+    PHP_CHECK_FUNC(dlopen, dl, root)
+    PHP_CHECK_FUNC(dlsym, dl, root)
+    ;;
+esac
