package wordpress:php-wasi@0.1.0;

interface output {
  enum channel {
    stdout,
    stderr,
  }

  headers: func(status: u16, headers: list<string>);
  write: func(destination: channel, bytes: list<u8>);
}

interface handler {
  record entry {
    key: string,
    value: string,
  }

  record request {
    script-path: string,
    request-uri: string,
    method: string,
    host: string,
    port: u32,
    body: list<u8>,
    stream-response: bool,
    content-type: option<string>,
    cookies: option<string>,
    server-entries: list<entry>,
    env: list<entry>,
  }

  record response {
    exit-status: s32,
    http-status: u16,
    headers: list<string>,
  }

  initialize: func(php-ini-path: string) -> result<_, string>;
  handle-request: func(request: request) -> result<response, string>;
}

interface cli {
  record entry {
    key: string,
    value: string,
  }

  record request {
    argv: list<string>,
    env: list<entry>,
    cwd: option<string>,
  }

  run: func(request: request) -> result<s32, string>;
}

world php {
  import output;
  export handler;
  export cli;
}
