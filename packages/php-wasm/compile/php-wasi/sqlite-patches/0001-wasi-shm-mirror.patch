+#ifdef SQLITE_WASI_SHM_MIRROR
+/*
+** WebAssembly component instances do not share linear memory. Keep a private
+** mirror and baseline in each instance, but make the native host the owner of
+** the canonical wal-index. Each exchange sends only coalesced dirty words
+** and receives only ranges newer than this mirror's per-region generations.
+*/
+typedef enum unixWasiShmMode {
+  UNIX_WASI_SHM_REFRESH,      /* Pull host deltas without scanning */
+  UNIX_WASI_SHM_COMMIT,       /* Push local deltas; skip host if clean */
+  UNIX_WASI_SHM_PRESERVE      /* Pull deltas around unpublished local bytes */
+} unixWasiShmMode;
+
+/* pMirrorMutex must be held by the caller. */
+static int unixWasiShmExchangeLocked(
+  unixShmNode *pNode,
+  unixWasiShmMode eMode
+){
+  wp_wasi_wal_shm_range_t *aRange = 0;
+  wp_wasi_wal_shm_exchange_result_t result;
+  u8 *aData = 0;
+  u8 *aExpected = 0;
+  u8 *aReplacement = 0;
+  sqlite3_uint64 nData = 0;
+  sqlite3_uint64 nRange = 0;
+  sqlite3_uint64 iData = 0;
+  sqlite3_uint64 iRange = 0;
+  int iRegion;
+  int rc = SQLITE_OK;
+
+  memset(&result, 0, sizeof(result));
+  if( pNode->hShm<0 || pNode->nRegion==0 ) return SQLITE_OK;
+  if( pNode->walShm==WP_WASI_WAL_SHM_INVALID_HANDLE ){
+    return SQLITE_IOERR_SHMMAP;
+  }
+  assert( (pNode->szRegion&3)==0 );
+  assert( pNode->apBaseline!=0 && pNode->aMirrorGeneration!=0 );
+  assert( sqlite3_mutex_held(pNode->pMirrorMutex) );
+  assert( eMode>=UNIX_WASI_SHM_REFRESH && eMode<=UNIX_WASI_SHM_PRESERVE );
+
+  /* First count consecutive dirty 32-bit words and their payload bytes. */
+  if( eMode!=UNIX_WASI_SHM_REFRESH ){
+    for(iRegion=0; iRegion<pNode->nRegion; iRegion++){
+      const u32 *aLocal = (const u32*)pNode->apRegion[iRegion];
+      const u32 *aBase = (const u32*)pNode->apBaseline[iRegion];
+      int nWord = pNode->szRegion/(int)sizeof(u32);
+      int i = 0;
+      while( i<nWord ){
+        int iFirst;
+        while( i<nWord && aLocal[i]==aBase[i] ) i++;
+        iFirst = i;
+        while( i<nWord && aLocal[i]!=aBase[i] ) i++;
+        if( i>iFirst ){
+          sqlite3_uint64 nByte = (sqlite3_uint64)(i-iFirst)*sizeof(u32);
+          nRange++;
+          nData += nByte;
+          if( nRange>0xffffffff || nData>0xffffffff ){
+            rc = SQLITE_TOOBIG;
+            goto exchange_done;
+          }
+        }
+      }
+    }
+  }
+  if( eMode==UNIX_WASI_SHM_COMMIT && nRange==0 && !pNode->mirrorUnsynced ){
+    goto exchange_done;
+  }
+  if( nRange!=0 && pNode->isReadonly && eMode==UNIX_WASI_SHM_COMMIT ){
+    rc = SQLITE_READONLY;
+    goto exchange_done;
+  }
+
+  if( nRange ){
+    if( nData>SQLITE_MAX_ALLOCATION_SIZE/2 ){
+      rc = SQLITE_NOMEM_BKPT;
+      goto exchange_done;
+    }
+    aRange = sqlite3_malloc64(nRange*sizeof(*aRange));
+    aData = sqlite3_malloc64(nData*2);
+    if( aRange==0 || aData==0 ){
+      rc = SQLITE_NOMEM_BKPT;
+      goto exchange_done;
+    }
+    aExpected = aData;
+    aReplacement = &aData[nData];
+
+    for(iRegion=0; iRegion<pNode->nRegion; iRegion++){
+      const u32 *aLocal = (const u32*)pNode->apRegion[iRegion];
+      const u32 *aBase = (const u32*)pNode->apBaseline[iRegion];
+      int nWord = pNode->szRegion/(int)sizeof(u32);
+      int i = 0;
+      while( i<nWord ){
+        int iFirst;
+        while( i<nWord && aLocal[i]==aBase[i] ) i++;
+        iFirst = i;
+        while( i<nWord && aLocal[i]!=aBase[i] ) i++;
+        if( i>iFirst ){
+          int nByte = (i-iFirst)*(int)sizeof(u32);
+          aRange[iRange].region = (u32)iRegion;
+          aRange[iRange].offset = (u32)(iFirst*sizeof(u32));
+          aRange[iRange].data_offset = (u32)iData;
+          aRange[iRange].length = (u32)nByte;
+          memcpy(&aExpected[iData], &aBase[iFirst], nByte);
+          memcpy(
+              &aReplacement[iData],
+              eMode==UNIX_WASI_SHM_PRESERVE ? &aBase[iFirst] : &aLocal[iFirst],
+              nByte
+          );
+          iData += nByte;
+          iRange++;
+        }
+      }
+    }
+    assert( iRange==nRange && iData==nData );
+  }
+
+  if( wp_wasi_wal_shm_exchange(
+          pNode->walShm, (u32)pNode->szRegion,
+          pNode->aMirrorGeneration, (size_t)pNode->nRegion,
+          aRange, (size_t)nRange, aExpected, aReplacement, (size_t)nData,
+          0, &result
+      )<0 ){
+    rc = errno==ENOMEM ? SQLITE_NOMEM_BKPT : SQLITE_IOERR_SHMMAP;
+    goto exchange_done;
+  }
+  if( result.generations_len!=(size_t)pNode->nRegion
+   || (result.generations_len && result.generations==0)
+   || (result.updates_len && result.updates==0)
+   || (result.data_len && result.data==0)
+   || result.epoch<pNode->mirrorEpoch
+  ){
+    rc = SQLITE_IOERR_SHMMAP;
+    goto exchange_done;
+  }
+  for(iRegion=0; iRegion<pNode->nRegion; iRegion++){
+    if( result.generations[iRegion]>result.epoch ){
+      rc = SQLITE_IOERR_SHMMAP;
+      goto exchange_done;
+    }
+  }
+
+  /* Validate every host range before changing either local image. */
+  for(iRange=0; iRange<result.updates_len; iRange++){
+    wp_wasi_wal_shm_range_t *pRange = &result.updates[iRange];
+    sqlite3_uint64 iDirty;
+    if( pRange->region>=(u32)pNode->nRegion
+     || pRange->length==0
+     || ((pRange->offset|pRange->data_offset|pRange->length)&3)!=0
+     || pRange->offset>(u32)pNode->szRegion
+     || pRange->length>(u32)pNode->szRegion-pRange->offset
+     || pRange->data_offset>result.data_len
+     || pRange->length>result.data_len-pRange->data_offset
+    ){
+      rc = SQLITE_IOERR_SHMMAP;
+      goto exchange_done;
+    }
+    for(iDirty=0; iDirty<nRange; iDirty++){
+      wp_wasi_wal_shm_range_t *pDirty = &aRange[iDirty];
+      if( pRange->region==pDirty->region
+       && pRange->offset<pDirty->offset+pDirty->length
+       && pDirty->offset<pRange->offset+pRange->length
+      ){
+        rc = SQLITE_IOERR_SHMMAP;
+        goto exchange_done;
+      }
+    }
+  }
+  /* Apply remote deltas before acknowledging this guest's local writes. */
+  for(iRange=0; iRange<result.updates_len; iRange++){
+    wp_wasi_wal_shm_range_t *pRange = &result.updates[iRange];
+    void *pLocal = &pNode->apRegion[pRange->region][pRange->offset];
+    void *pBase = &pNode->apBaseline[pRange->region][pRange->offset];
+    const void *pRemote = &result.data[pRange->data_offset];
+    memcpy(pBase, pRemote, pRange->length);
+    memcpy(pLocal, pRemote, pRange->length);
+  }
+  for(iRange=0; iRange<nRange; iRange++){
+    wp_wasi_wal_shm_range_t *pRange = &aRange[iRange];
+    memcpy(
+        &pNode->apBaseline[pRange->region][pRange->offset],
+        &aReplacement[pRange->data_offset], pRange->length
+    );
+  }
+  memcpy(
+      pNode->aMirrorGeneration, result.generations,
+      result.generations_len*sizeof(result.generations[0])
+  );
+  pNode->mirrorEpoch = result.epoch;
+  pNode->mirrorUnsynced = 0;
+
+exchange_done:
+  wp_wasi_wal_shm_exchange_result_free(&result);
+  sqlite3_free(aData);
+  sqlite3_free(aRange);
+  return rc;
+}
+
+/* Pull only when the host's scalar epoch says this mirror is stale. */
+static int unixWasiShmRefreshIfStaleLocked(
+  unixShmNode *pNode,
+  unixWasiShmMode eMode
+){
+  uint64_t hostEpoch = 0;
+  assert( sqlite3_mutex_held(pNode->pMirrorMutex) );
+  assert( eMode==UNIX_WASI_SHM_REFRESH || eMode==UNIX_WASI_SHM_PRESERVE );
+  if( pNode->mirrorUnsynced ){
+    return unixWasiShmExchangeLocked(pNode, eMode);
+  }
+  if( wp_wasi_wal_shm_current_epoch(pNode->walShm, &hostEpoch)<0 ){
+    return errno==ENOMEM ? SQLITE_NOMEM_BKPT : SQLITE_IOERR_SHMMAP;
+  }
+  if( hostEpoch<pNode->mirrorEpoch ) return SQLITE_IOERR_SHMMAP;
+  if( hostEpoch==pNode->mirrorEpoch ) return SQLITE_OK;
+  return unixWasiShmExchangeLocked(pNode, eMode);
+}
+
+/* Avoid scanning every mapped region when a clean connection is closed. */
+static int unixWasiShmCommitIfNeeded(unixShmNode *pNode){
+  int rc = SQLITE_OK;
+  sqlite3_mutex_enter(pNode->pMirrorMutex);
+  if( pNode->mirrorPossiblyDirty || pNode->mirrorUnsynced ){
+    rc = unixWasiShmExchangeLocked(pNode, UNIX_WASI_SHM_COMMIT);
+    if( rc==SQLITE_OK && pNode->nMirrorExclusive==0 ){
+      pNode->mirrorPossiblyDirty = 0;
+    }
+  }
+  sqlite3_mutex_leave(pNode->pMirrorMutex);
+  return rc;
+}
+
+/* Never refresh over unpublished bytes owned by a sibling connection. */
+static int unixWasiShmCatchUp(unixShmNode *pNode){
+  int rc;
+  sqlite3_mutex_enter(pNode->pMirrorMutex);
+  rc = unixWasiShmRefreshIfStaleLocked(
+      pNode,
+      pNode->nMirrorExclusive==0
+          ? UNIX_WASI_SHM_REFRESH : UNIX_WASI_SHM_PRESERVE
+  );
+  sqlite3_mutex_leave(pNode->pMirrorMutex);
+  return rc;
+}
+
+static void unixWasiShmFatal(int rc, const char *zOperation){
+  sqlite3_log(rc, "WASI wal-index mirror %s failed", zOperation);
+  abort();
+}
