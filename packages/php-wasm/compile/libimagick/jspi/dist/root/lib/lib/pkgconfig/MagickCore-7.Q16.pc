prefix=/root/lib
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/ImageMagick-7
includearchdir=/root/lib/include/ImageMagick-7
libname=MagickCore-7.Q16
moduledir=${exec_prefix}/lib/ImageMagick-7.1.1/modules-Q16
 
Name: MagickCore
Description: MagickCore - C API for ImageMagick (ABI Q16)
URL: https://github.com/ImageMagick
Version: 7.1.1
Cflags: -I${includearchdir} -I${includedir} -DMAGICKCORE_HDRI_ENABLE=0 -DMAGICKCORE_QUANTUM_DEPTH=16 -DMAGICKCORE_CHANNEL_MASK_DEPTH=32
Libs: -L${libdir} -l${libname}
Libs.private: -L${libdir} -l${libname}        -ljpeg                                  -lm         -lm
