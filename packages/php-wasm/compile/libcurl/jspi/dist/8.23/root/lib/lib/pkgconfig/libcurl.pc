prefix=/root/lib
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include
supported_protocols="DICT FILE HTTP HTTPS"
supported_features="alt-svc HSTS HTTPS-proxy IPv6 Largefile libz NTLM SSL threadsafe UnixSockets"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with HTTP, FTP, etc.
License: curl
Copyright: Copyright (C) Daniel Stenberg, <daniel@haxx.se>, et al.
Version: 8.23.0
Source: https://curl.se/download/curl-8.23.0.tar.gz
Requires: zlib,openssl
Libs: -L${libdir} -lcurl -lssl -lcrypto -lssl -lcrypto  -lz
Libs.private: -L/root/lib/lib -lssl -lcrypto -lssl -lcrypto -lz
Cflags: -I${includedir} -DCURL_STATICLIB
Cflags.private: -DCURL_STATICLIB
Link.ABI: c
