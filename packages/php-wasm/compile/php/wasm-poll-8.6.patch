+#ifdef __EMSCRIPTEN__
+/* Emscripten's poll() does not wait, so yield to the event loop between checks. */
+static int php_poll_wasm(struct pollfd *fds, nfds_t count, int timeout_ms)
+{
+	double deadline = emscripten_get_now() + timeout_ms;
+	int result = poll(fds, count, 0);
+
+	while (result == 0 && timeout_ms != 0) {
+		int sleep_ms = 10;
+		if (timeout_ms > 0) {
+			double remaining = deadline - emscripten_get_now();
+			if (remaining <= 0) {
+				break;
+			}
+			if (remaining < sleep_ms) {
+				sleep_ms = (int) remaining + 1;
+			}
+		}
+		emscripten_sleep(sleep_ms);
+		result = poll(fds, count, 0);
+	}
+
+	return result;
+}
