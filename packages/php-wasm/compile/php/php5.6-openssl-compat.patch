+
+static void DH_get0_key(const DH *dh, const BIGNUM **pub_key, const BIGNUM **priv_key)
+{
+	if (pub_key) *pub_key = dh->pub_key;
+	if (priv_key) *priv_key = dh->priv_key;
+}
+
+static int DH_set0_pqg(DH *dh, BIGNUM *p, BIGNUM *q, BIGNUM *g)
+{
+	if (p) { BN_free(dh->p); dh->p = p; }
+	if (q) { BN_free(dh->q); dh->q = q; }
+	if (g) { BN_free(dh->g); dh->g = g; }
+	return 1;
+}
+
+static int DH_set0_key(DH *dh, BIGNUM *pub_key, BIGNUM *priv_key)
+{
+	if (pub_key) { BN_free(dh->pub_key); dh->pub_key = pub_key; }
+	if (priv_key) { BN_free(dh->priv_key); dh->priv_key = priv_key; }
+	return 1;
+}
