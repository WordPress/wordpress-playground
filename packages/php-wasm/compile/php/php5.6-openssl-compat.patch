+	if (priv_key) { BN_free(d->priv_key); d->priv_key = priv_key; }
+	return 1;
+}
+
+static void DH_get0_pqg(const DH *dh, const BIGNUM **p, const BIGNUM **q, const BIGNUM **g)
+{
+	if (p) *p = dh->p;
+	if (q) *q = dh->q;
+	if (g) *g = dh->g;
