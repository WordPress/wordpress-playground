+/* Wrapper with correct compare_r_func_t signature that delegates to a
+ * compare_func_t passed via the arg pointer.  This avoids casting a
+ * 2-parameter function pointer to a 3-parameter type, which is undefined
+ * behavior in C and causes "null function or function signature mismatch"
+ * traps in WebAssembly. */
+static int _zend_qsort_compare_wrapper(const void *a, const void *b TSRMLS_DC, void *arg)
+{
+	compare_func_t compare = (compare_func_t)arg;
+	return compare(a, b TSRMLS_CC);
+}
+
 ZEND_API void zend_qsort(void *base, size_t nmemb, size_t siz, compare_func_t compare TSRMLS_DC)
 {
-	zend_qsort_r(base, nmemb, siz, (compare_r_func_t)compare, NULL TSRMLS_CC);
+	zend_qsort_r(base, nmemb, siz, _zend_qsort_compare_wrapper, (void *)compare TSRMLS_CC);
 }

