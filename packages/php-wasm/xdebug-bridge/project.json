{
	"name": "php-wasm-xdebug-bridge",
	"$schema": "../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/php-wasm/xdebug-bridge/src",
	"projectType": "library",
	"targets": {
		"dev": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node --no-warnings --experimental-wasm-stack-switching --experimental-wasm-jspi --loader=./packages/meta/src/node-es-module-loader/loader.mts ./packages/php-wasm/xdebug-bridge/src/index.ts",
				"tty": true
			}
		},
		"lint": {
			"executor": "@nx/eslint:lint",
			"outputs": ["{options.outputFile}"],
			"options": {
				"lintFilePatterns": ["packages/php-wasm/xdebug-bridge/**/*.ts"]
			}
		},
		"test": {
			"executor": "@nx/vite:test",
			"outputs": [
				"{workspaceRoot}/coverage/packages/php-wasm/xdebug-bridge"
			],
			"options": {
				"reportsDirectory": "../../../coverage/packages/php-wasm/xdebug-bridge",
				"testFiles": ["mock-test.spec.ts"]
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"options": {
				"commands": [
					"tsc -p packages/php-wasm/xdebug-bridge/tsconfig.spec.json --noEmit"
				]
			}
		}
	},
	"tags": ["scope:php-binaries"]
}
