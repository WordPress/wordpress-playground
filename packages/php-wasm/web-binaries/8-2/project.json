{
	"name": "php-wasm-web-binaries-8-2",
	"$schema": "../../../../node_modules/nx/schemas/project-schema.json",
	"projectType": "library",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "node tools/scripts/build-wasm-binary-package.mjs --platform=web --version=8-2",
				"parallel": false
			}
		},
		"publish": {
			"executor": "nx:run-commands",
			"options": {
				"command": "cd dist/packages/php-wasm/web-binaries/8-2 && npm publish",
				"parallel": false
			},
			"dependsOn": ["build"]
		}
	},
	"tags": ["scope:php-binaries", "type:wasm-binary"],
	"implicitDependencies": ["php-wasm-web-8-2"]
}
