{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"preferredVersions": {
		"wp": "latest",
		"php": "8.3"
	},
	"extraLibraries": ["wp-cli"],
	"steps": [
		{
			"step": "activatePlugin",
			"pluginPath": "static-site-generator/static-site-generator.php"
		},
		{
			"step": "wp-cli",
			"command": "wp static-site export --output=/exports/static-site.zip --fetch-mode=internal"
		}
	]
}
